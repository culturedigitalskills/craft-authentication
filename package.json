{
    "name": "craft-authentication",
    "version": "0.14.0",
    "private": true,
    "packageManager": "pnpm@11.5.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node scripts/generate-build-info.js && dotenv run -f .env.local -- next dev",
        "build-info": "node scripts/generate-build-info.js",
        "docker:up": "docker compose -f docker-compose.dev.yml --env-file .env.local up -d",
        "docker:down": "docker compose -f docker-compose.dev.yml --env-file .env.local down",
        "garage:init": "node scripts/init-garage.js .env.local craft-authentication",
        "db:studio": "dotenv run -f .env.local -- prisma studio",
        "db:migrate": "dotenv run -f .env.local -- prisma migrate dev",
        "db:rollback": "dotenv run -f .env.local -- prisma migrate deploy",
        "db:push": "dotenv run -f .env.local -- prisma db push",
        "db:backfill-crafts": "dotenv run -f .env.local -- node scripts/backfill-crafts.js",
        "prod:db:backfill-crafts": "dotenv run -f .env.production -- node scripts/backfill-crafts.js",
        "build": "dotenv run -f .env.production -- next build",
        "start": "dotenv run -f .env.production -- next start",
        "lint": "eslint .",
        "lint:fix": "pnpm lint --fix",
        "db:generate": "dotenv run -f .env.local -- prisma generate",
        "docker:build": "node scripts/generate-build-info.js && docker compose --env-file .env.production build --pull --no-cache app",
        "prod:docker:up": "docker compose --env-file .env.production up -d",
        "prod:docker:down": "docker compose --env-file .env.production down",
        "prod:docker:logs": "docker compose --env-file .env.production logs -f app",
        "prod:db:push": "dotenv run -f .env.production -- prisma db push",
        "prod:db:studio": "dotenv run -f .env.production -- prisma studio",
        "test-deploy": "pnpm build-info && pnpm prod:docker:down && pnpm docker:build && pnpm prod:docker:up",
        "test": "dotenv run -f .env.local -- vitest run",
        "test:watch": "dotenv run -f .env.local -- vitest",
        "deps:update": "node scripts/update-deps.js"
    },
    "dependencies": {
        "@atproto/api": "^0.29.4",
        "@aws-sdk/client-s3": "^3.1156.0",
        "@better-auth/prisma-adapter": "^1.7.12",
        "@contentauth/c2pa-node": "^0.9.10",
        "@contentauth/c2pa-web": "^0.15.4",
        "@hookform/resolvers": "^6.0.0",
        "@openrouter/sdk": "^1.5.7",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-menubar": "^1.2.1",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@scure/base": "^2.4.0",
        "bcryptjs": "^3.0.3",
        "better-auth": "^1.7.12",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "culori": "^4.0.2",
        "ffmpeg-static": "^5.2.0",
        "hash-wasm": "^4.12.0",
        "lucide-react": "^1.61.0",
        "next": "16.4.3",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "nextjs-toploader": "^3.9.17",
        "pg": "^8.23.1",
        "qrcode": "^1.5.4",
        "qrcode.react": "^4.2.0",
        "rate-limiter-flexible": "^11.2.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.91.0",
        "react-icons": "^5.7.0",
        "react-router-dom": "^7.18.4",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/culori": "^4.0.1",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "baseline-browser-mapping": "^2.11.32",
        "dotenv": "^18.0.9",
        "eslint": "^10.13.0",
        "eslint-config-next": "16.4.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "kysely": "0.28.0",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "prisma": "7.10.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    }
}
